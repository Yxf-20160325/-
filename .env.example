# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交）

# ── NVIDIA 模型（五子棋 AI 可选）──
# 在 https://build.nvidia.com 获取
NVIDIA_API_KEY=
# 默认模型；可换成更快的，例如 nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# 置为 1 才会启用模型决策；留空/0 则只用内置算法（更快更稳）
GOMOKU_USE_NVIDIA=0

# ── 应用密钥 ──
APP_SECRET=
WEATHER_API_KEY=

# ── 微信小程序登录 ──
# 小程序 appid（默认已填 wx136ff04f12ed97bc）
WECHAT_APPID=wx136ff04f12ed97bc
# 小程序 AppSecret（微信公众平台 → 开发管理 → 开发设置）
# 未配置时登录会走降级模式（用昵称直接登录），功能可用但无法获取 openid
WECHAT_APP_SECRET=
