# ============================================================
# 服务端环境变量清单
# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交）
# Render 部署时请在 Dashboard → Environment 里逐个添加
# ============================================================

# ── 服务端口 ──
# Render 会自动注入 PORT，本地开发可留空（默认 147）
PORT=147

# ── 管理员密码 ──
# 管理后台初始密码；留空则使用默认值 admin123
# 注意：运行中管理员可改密码（只存内存），重启后恢复为此处的值
ADMIN_PASSWORD=

# ── 天气 API ──
# 聚合天气代理的 key；留空则使用代码里的默认值
WEATHER_API_KEY=

# ── 微信小程序登录 ──
# 小程序 appid；留空则使用默认值 wx136ff04f12ed97bc
WECHAT_APPID=wx136ff04f12ed97bc
# 小程序 AppSecret（微信公众平台 → 开发管理 → 开发设置）
# 建议配置：不配置时登录走降级模式（用昵称直接登录，拿不到真实 openid）
WECHAT_APP_SECRET=

# ── NVIDIA 模型（你画我猜语义判分用；五子棋默认不用模型）──
# 在 https://build.nvidia.com 获取
NVIDIA_API_KEY=
# API 地址，一般不用改
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 默认模型
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# 是否让模型参与五子棋决策：1=开启，0/留空=只用内置算法（更快更稳）
GOMOKU_USE_NVIDIA=0
