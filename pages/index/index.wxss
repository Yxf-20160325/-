.container{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;background:#ffffff}.logo{font-size:120rpx;margin-bottom:30rpx}.title{font-size:48rpx;color:#333333;font-weight:bold;margin-bottom:10rpx}.subtitle{font-size:28rpx;color:#888888;margin-bottom:40rpx}.avatar-section{display:flex;flex-direction:column;align-items:center;margin-bottom:30rpx}.avatar-container{width:160rpx;height:160rpx;border-radius:50%;background:rgba(0,0,0,0.05);display:flex;align-items:center;justify-content:center;overflow:hidden;border:4rpx solid rgba(0,0,0,0.1);margin-bottom:16rpx}.avatar-img{width:100%;height:100%;border-radius:50%}.avatar-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.03)}.avatar-icon{font-size:60rpx}.avatar-tip{font-size:24rpx;color:#999999}.form{width:80%;background:#ffffff;border-radius:24rpx;padding:40rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,0.06);border:2rpx solid #f0f0f0}.form-item{margin-bottom:30rpx}.label{font-size:28rpx;color:#333;margin-bottom:10rpx;display:block}.input{width:100%;height:80rpx;border:2rpx solid #eee;border-radius:12rpx;padding:0 20rpx;font-size:28rpx;box-sizing:border-box}.enter-btn{width:100%;height:88rpx;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#ffffff;font-size:32rpx;border-radius:44rpx;margin-top:20rpx}.wechat-login-btn{width:100%;height:88rpx;background:linear-gradient(135deg,#07c160 0%,#10b981 100%);color:#ffffff;font-size:32rpx;border-radius:44rpx;margin-top:20rpx;display:flex;align-items:center;justify-content:center;gap:16rpx}.wechat-icon{font-size:40rpx}.tap-area{position:fixed;bottom:60rpx;left:0;right:0;text-align:center;padding:20rpx}.tap-hint{font-size:22rpx;color:#aaaaaa}
