@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

@keyframes wave1 {
  0%, 100% { height: 20rpx; }
  50% { height: 40rpx; }
}

@keyframes wave2 {
  0%, 100% { height: 30rpx; }
  50% { height: 20rpx; }
}

@keyframes wave3 {
  0%, 100% { height: 25rpx; }
  50% { height: 45rpx; }
}

.audio-player-container {
  position: fixed;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  z-index: 1000;
}

.audio-player-bar {
  background: rgba(87, 107, 149, 0.95);
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
}

.audio-player-content {
  display: flex;
  align-items: center;
}

.audio-player-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.audio-wave {
  display: flex;
  align-items: center;
  height: 40rpx;
  gap: 6rpx;
}

.wave-bar {
  width: 6rpx;
  background: white;
  border-radius: 3rpx;
}

.wave-bar-1 {
  animation: wave1 0.8s ease-in-out infinite;
}

.wave-bar-2 {
  animation: wave2 0.8s ease-in-out infinite 0.2s;
}

.wave-bar-3 {
  animation: wave3 0.8s ease-in-out infinite 0.4s;
}

.audio-player-info {
  flex: 1;
  max-width: 50%;
}

.audio-player-filename {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audio-player-progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  position: relative;
}

.audio-player-progress {
  height: 100%;
  background: white;
  border-radius: 4rpx;
  transition: width 0.1s linear;
}

.audio-player-thumb {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  background: white;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.audio-player-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.audio-player-controls {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.audio-player-pause {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.audio-player-close {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333333;
  font-size: 32rpx;
}

