  display: flex;
  align-items: center;
  min-height: calc(110rpx + env(safe-area-inset-top));
  padding: calc(env(safe-area-inset-top) + 16rpx) 28rpx 16rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.98);
  border-bottom: 1rpx solid #ededed;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.08);
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s ease;
  pointer-events: none;
}
.msg-notify--show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.msg-notify-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.msg-notify-avatar-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}
.msg-notify-avatar-text {
  font-size: 34rpx;
  font-weight: 600;
}
.msg-notify-body {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}
.msg-notify-name {
  font-size: 26rpx;
  color: #999999;
  font-weight: 600;
  line-height: 1.2;
}
.msg-notify-content {
  font-size: 28rpx;
  color: #333;
  margin-top: 4rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.msg-notify-close {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
  color: #999;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-btn {
  padding: 16rpx 60rpx;
  background: #f5f5f5;
  color: #333333;
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 通话用户按钮 */
.call-user-btn {
  background: #28a745;
  color: #333333;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  line-height: 1.5;
}
.call-user-btn:active {
  background: #218838;
}

/* 来电界面 */
.incoming-call-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.incoming-call-content {
  width: 70%;
  background: white;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.incoming-call-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}
.incoming-call-icon {
  font-size: 60rpx;
}
.incoming-call-label {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.incoming-call-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}
.incoming-call-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg,#f5f5f5,#ffffff);
  color: #333333;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.incoming-call-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.incoming-call-status {
  font-size: 28rpx;
  color: #999;
}
.incoming-call-actions {
  display: flex;
  gap: 80rpx;
}
.incoming-call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.incoming-call-btn-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #333333;
}
.incoming-call-btn.reject .incoming-call-btn-icon {
  background: #ff4444;
}
.incoming-call-btn.accept .incoming-call-btn-icon {
  background: #28a745;
}
.incoming-call-btn-label {
  font-size: 26rpx;
  color: #666;
}
/* 日志列表面板 */
.logs-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.logs-panel-content {
  width: 80%;
  max-width: 700rpx;
  height: 75%;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.logs-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #f8f8f8;
}
.logs-panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}
.logs-panel-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}
.logs-panel-body {
  flex: 1;
  overflow: hidden;
}
.logs-scroll {
  height: 100%;
  padding: 20rpx;
}
.log-entry {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #666;
  overflow-wrap: break-word;
  word-wrap: break-word;
}
.log-time {
  color: #999;
  font-size: 24rpx;
  margin-right: 12rpx;
}
.log-message {
  color: #333;
}
.logs-panel-footer {
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: center;
}
.logs-clear-btn {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}