    console.error("视频播放错误:", e.detail)
    wx.showModal({
      title: '提示',
      content: '视频播放失败',
      showCancel: false,
      confirmText: '确定'
    })
    setTimeout(() => {
      this.closeVideoPlayer()
    }, 2000)
  },

  onVideoContentTap() {
  },

  onModalContentTap() {
  },

  handleUnsupportedFile(filename) {
    wx.showModal({
      title: '无法打开文件',
      content: `当前不支持预览 "${filename}" 类型的文件`,
      showCancel: false,
      confirmText: '复制链接',
      success: (res) => {
        const fileUrl = this.data.messages.find(m => m.filename === filename)?.fileUrl
        if (fileUrl && res.confirm) {
          wx.setClipboardData({
            data: fileUrl,
            success: () => {
              wx.showModal({
                title: '提示',
                content: '链接已复制',
                showCancel: false,
                confirmText: '确定'
              })
            },
            fail: () => {
              wx.showModal({
                title: '提示',
                content: '复制失败',
                showCancel: false,
                confirmText: '确定'
              })
            }
          })
        }
      }
    })
  },

  formatFileSize(bytes) {
    if (bytes === 0) return '0 B'
    const k = 1024
    const sizes = ['B', 'KB', 'MB', 'GB']
    const i = Math.floor(Math.log(bytes) / Math.log(k))
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i]
  },

  bindKeyInput(e) {
    this.setData({ inputValue: e.detail.value })
  },

  hasPermission(permissionName) {
    const permissions = this.data.userPermissions
    if (!permissions) {
      return true
    }
    // 如果该权限字段在服务端权限对象中存在，按字段值判断
    if (permissionName in permissions) {
      return permissions[permissionName] !== false
    }
    // 如果不存在（如 allowSendMessages 服务端未下发），回退检查基础 allowAccess
    return permissions.allowAccess !== false
  },

  sendMessage() {
    console.log("sendMessage被调用")
    console.log("sending状态:", this.data.sending)
    console.log("connected状态:", this.data.connected)
    console.log("输入内容:", this.data.inputValue)

    const now = Date.now()
    if (now - this.lastSendTime < this.sendInterval) {
      console.log("发送太快，忽略")
      return
    }

    if (this.data.sending) {
      console.log("正在发送中，忽略")
      return
    }

    if (this.data.kicked) {
      wx.showModal({
        title: '提示',
        content: '你已被踢出',
        showCancel: false,
        confirmText: '确定'
      })
      return
    }

    var content = this.data.inputValue.trim()
    if (!content) {
      wx.showModal({
        title: '提示',
        content: '请输入内容',
        showCancel: false,
        confirmText: '确定'
      })
      return
    }

    if (!this.data.connected) {
      wx.showModal({
        title: '发送失败',
        content: '网络连接未建立，请检查网络后重试。是否尝试重新连接？',
        confirmText: '重新连接',
        cancelText: '取消',
        success: (res) => {
          if (res.confirm) {
            this.initSocket()
          }
        }
      })
      return
    }

    if (!this.hasPermission('allowSendMessages')) {
      wx.showModal({
        title: '提示',
        content: '您没有发送消息的权限',
        showCancel: false,
        confirmText: '确定'
      })
      return
    }

    this.lastSendTime = now

    this.setData({ inputValue: "", sending: true })

    const msgId = Date.now().toString()
    const msgData = {
      message: content,
      type: "text",
      clientMessageId: msgId,
      avatarUrl: this.data.avatarUrl || ''
    }

    this.sendSocketMessage("message", msgData, (err) => {
      this.setData({ sending: false })
      if (err) {
        console.error("发送失败", err)
      }
    })

    if (!this.messageIds) {
      this.messageIds = []
    }
    this.messageIds.push(msgId)
    this.setData({
      messages: this.data.messages.concat([{
        id: msgId,
        user: { nickName: this.data.username, avatarUrl: this.data.avatarUrl },
        content: content,
        time: this.formatTime(new Date()),
        isSelf: true
      }]),
      scrollTop: 999999
    })
  },

  formatTime(date) {
    const year = date.getFullYear()
    const month = date.getMonth() + 1
    const day = date.getDate()
    const hour = date.getHours()
    const minute = date.getMinutes()
    const second = date.getSeconds()
    return `${[year, month, day].map(formatNumber).join('/')} ${[hour, minute, second].map(formatNumber).join(':')}`
  },

  formatNumber(n) {
    n = n.toString()
    return n[1] ? n : `0${n}`
  },

  formatFileSize(bytes) {
    if (bytes === 0) return '0 B'
    const k = 1024
    const sizes = ['B', 'KB', 'MB', 'GB']
    const i = Math.floor(Math.log(bytes) / Math.log(k))
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i]
  },

  formatTimestamp(timestamp) {
    if (!timestamp) return this.formatTime(new Date())
    if (typeof timestamp === 'number') {
      return this.formatTime(new Date(timestamp))
    }
    const match = timestamp.match(/(\d+):(\d+)(?::(\d+))?\s*(AM|PM)?/)
    if (match) {
      let hours = parseInt(match[1])
      const minutes = parseInt(match[2])
      const period = match[4]
      if (period === 'PM' && hours < 12) {
        hours += 12
      } else if (period === 'AM' && hours === 12) {
        hours = 0
      }
      if (hours >= 0 && hours <= 23 && minutes >= 0 && minutes <= 59) {
        return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`
      }
    }
    return this.formatTime(new Date())
  },

  formatAudioTime(seconds) {
    if (!seconds || isNaN(seconds)) return "00:00"
    const mins = Math.floor(seconds / 60)
    const secs = Math.floor(seconds % 60)
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`
  },

  formatAudioDuration(duration) {
    if (!duration || isNaN(duration) || duration <= 0) return ''
    if (duration >= 60) {
      const mins = Math.floor(duration / 60)
      const secs = Math.floor(duration % 60)
      return `${mins}'${secs}"`
    }
    return duration.toFixed(1) + 's'
  },

  getPercentage(votes, total) {
    if (!total || total <= 0) return "0"
    return (votes / total * 100).toFixed(1)
  },

  getAudioStatus(audioId) {
    const playingAudios = this.data.playingAudios || []
    const audio = playingAudios.find(a => a.id === audioId)
    if (!audio) return '▶️'
    return audio.status === 'playing' ? '⏹️' : '⏸️'
  },

  toggleAudioPlay(e) {
    if (!e || !e.currentTarget) {
      console.log('toggleAudioPlay: 无效的事件对象')
      return
    }

    const audioId = e.currentTarget.dataset.id
    if (!audioId) {
      console.log('toggleAudioPlay: 无效的音频ID')
      return
    }

    if (!this.audioContexts) {
      console.log('toggleAudioPlay: audioContexts 未初始化')
      return
    }

    const ctx = this.audioContexts[audioId]
    if (!ctx) {
      console.log('toggleAudioPlay: 音频上下文不存在:', audioId)
      return
    }

    const audios = this.data.playingAudios || []
    const index = audios.findIndex(a => a.id === audioId)
    if (index < 0) {
      console.log('toggleAudioPlay: 音频不在播放列表中:', audioId)
      return
    }

    console.log('toggleAudioPlay:', audioId, '当前状态:', audios[index].status)

    if (audios[index].status === 'playing') {
      try {
        ctx.pause()
        console.log('音频已暂停:', audioId)
      } catch (err) {
        console.error('暂停音频失败:', err)
      }

      const timerKey = 'audioProgressTimer_' + audioId
      if (this[timerKey]) {
        clearInterval(this[timerKey])
        this[timerKey] = null
        console.log('进度定时器已清除:', audioId)
      }

      const updatedAudios = [...audios]
      updatedAudios[index] = {
        ...updatedAudios[index],
        status: 'paused'
      }
      this.setData({ playingAudios: updatedAudios })
      console.log('播放状态已更新为 paused:', audioId)
    } else {
      if (audios[index].status === 'ended') {
        try {
          ctx.seek(0)
          console.log('音频已重置到开始:', audioId)
        } catch (err) {
          console.error('重置音频失败:', err)
        }
      }

      try {
        ctx.play()
        console.log('音频已播放:', audioId)
      } catch (err) {
        console.error('播放音频失败:', err)
        return
      }

      const updatedAudios = [...audios]
      updatedAudios[index] = {
        ...updatedAudios[index],
        status: 'playing',
        currentTime: 0
      }
      this.setData({ playingAudios: updatedAudios })
      this.updateAudioProgress(audioId)
      console.log('播放状态已更新为 playing:', audioId)
    }
  },

  stopAudio(e) {
    console.log('stopAudio 被调用')

    if (e && typeof e.stopPropagation === 'function') {
      e.stopPropagation()
    }

    const audioId = e ? (e.currentTarget ? e.currentTarget.dataset.id : null) : null
    console.log('stopAudio: audioId =', audioId)

    if (audioId) {
      const timerKey = 'audioProgressTimer_' + audioId
      if (this[timerKey]) {
        clearInterval(this[timerKey])
        this[timerKey] = null
        console.log('stopAudio: 进度定时器已清除:', audioId)
      }

      if (this.audioContexts && this.audioContexts[audioId]) {
        const ctx = this.audioContexts[audioId]
        try {
          ctx.stop()
          ctx.destroy()
          console.log('stopAudio: 音频已停止并销毁:', audioId)
        } catch (err) {
          console.warn("停止音频失败:", err)
        }
        delete this.audioContexts[audioId]
        console.log('stopAudio: 音频上下文已删除:', audioId)
      } else {
        console.log('stopAudio: 音频上下文不存在:', audioId)
      }

      const audios = this.data.playingAudios || []
      const updatedAudios = audios.filter(a => a.id !== audioId)
      this.setData({ playingAudios: updatedAudios })
      console.log('stopAudio: 播放列表已更新，剩余:', updatedAudios.length)
    } else {
      console.log('stopAudio: 停止所有音频')

      if (this.audioContexts) {
        for (const id in this.audioContexts) {
          const timerKey = 'audioProgressTimer_' + id
          if (this[timerKey]) {
            clearInterval(this[timerKey])
            this[timerKey] = null
          }
          try {
            this.audioContexts[id].stop()
            this.audioContexts[id].destroy()
            console.log('stopAudio: 音频已停止:', id)
          } catch (err) {
            console.warn("停止音频失败:", err)
          }
        }
        this.audioContexts = {}
        console.log('stopAudio: 所有音频上下文已清空')
      } else {
        console.log('stopAudio: audioContexts 为空')
      }

      this.setData({ playingAudios: [] })
      console.log('stopAudio: 播放列表已清空')
    }
  },

  seekAudio(e) {
    const audioId = e.currentTarget.dataset.id
    if (!audioId) return

    const ctx = this.audioContexts[audioId]
    const audios = this.data.playingAudios
    const index = audios.findIndex(a => a.id === audioId)
    if (!ctx || index < 0) return

    const progressBar = e.currentTarget
    const rect = progressBar.getBoundingClientRect ? progressBar.getBoundingClientRect() : { width: 200 }
    const clientWidth = rect.width || 200
    const clickX = e.detail.x || e.touches?.[0]?.clientX || 0
    const offsetX = clickX - (progressBar.offsetLeft || 0)
    const percent = Math.max(0, Math.min(1, offsetX / clientWidth))

    const newTime = percent * (audios[index].duration || 1)
    ctx.seek(newTime)

    const updatedAudios = [...audios]
    updatedAudios[index] = {
      ...updatedAudios[index],
      currentTime: newTime
    }
    this.setData({ playingAudios: updatedAudios })
  },

  goBack() {
    wx.navigateBack()
  },

  onShareAppMessage() {
    return {
      title: '聊天室 - ' + this.data.roomName,
      path: '/pages/chat/chat?room=' + encodeURIComponent(this.data.roomName),
      imageUrl: ''
    }
  },

  onHide() {
    console.log("页面隐藏，保持Socket连接")
    console.log("当前下载任务:", this.data.downloads)
    // 离开页面时收起顶部通知，避免悬挂
    this.hideNotification()
  },

  onShow() {
    console.log("页面显示")

    // 检查连接状态，如果断开则自动重连
    if (!this.data.connected && !this.data.connecting && !this.isInitializingSocket) {
      console.log("页面恢复时检测到连接已断开，尝试重连")
      this.initSocket()
    }

    const pendingDownloads = this.data.downloads.filter(d =>
      d.status === '下载中' && d.progress < 100 && !d.isRestored
    )
    console.log("需要恢复的下载任务:", pendingDownloads)

    if (pendingDownloads.length > 0) {
      wx.showToast({ title: `恢复${pendingDownloads.length}个下载任务`, icon: 'none', duration: 2000 })

      const updatedDownloads = this.data.downloads.map(d => {
        if (d.status === '下载中' && d.progress < 100) {
          return { ...d, isRestored: true }
        }
        return d
      })
      this.setData({ downloads: updatedDownloads })

      pendingDownloads.forEach(task => {
        console.log("重新下载:", task.filename)
        // 下载完成后移除旧的 isRestored 条目，防止重复
        const oldId = task.id
        this.doDownloadFile(task.url, task.filename, 0)
      })
    }
  },

  // ===== 投票相关功能 =====

  showCreatePoll() {
    this.setData({
      showCreatePollModal: true,
      pollTitle: "",
      pollOptions: ["", ""],
      pollMultiple: false,
      pollAnonymous: false
    })
  },

  closeCreatePoll() {
    this.setData({ showCreatePollModal: false })
  },

  bindPollTitle(e) {
    this.setData({ pollTitle: e.detail.value })
  },

  bindPollOption(e) {
    const index = parseInt(e.currentTarget.dataset.index)
    const options = [...this.data.pollOptions]
    options[index] = e.detail.value
    this.setData({ pollOptions: options })
  },

  addPollOption() {
    if (this.data.pollOptions.length < 6) {
      this.setData({ pollOptions: [...this.data.pollOptions, ""] })
    }
  },

  deletePollOption(e) {
    const index = parseInt(e.currentTarget.dataset.index)
    if (this.data.pollOptions.length > 2) {
      const options = this.data.pollOptions.filter((_, i) => i !== index)
      this.setData({ pollOptions: options })
    }
  },

  setPollMultiple(e) {
    const value = e.currentTarget.dataset.value === 'true'
    this.setData({ pollMultiple: value })
  },

  togglePollAnonymous() {
    this.setData({ pollAnonymous: !this.data.pollAnonymous })
  },

  createPoll() {
    const title = this.data.pollTitle.trim()
    const options = this.data.pollOptions.filter(o => o.trim())

    if (!title) {
      wx.showModal({
        title: '提示',
        content: '请输入投票标题',
        showCancel: false,
        confirmText: '确定'
      })
      return
    }

    if (options.length < 2) {
      wx.showModal({
        title: '提示',
        content: '至少需要2个选项',
        showCancel: false,
        confirmText: '确定'
      })
      return
    }

    const msgId = Date.now().toString()
    const pollData = {
      id: msgId,
      title: title,
      options: options.map(text => ({ text, votes: 0 })),
      multiple: this.data.pollMultiple,
      isAnonymous: this.data.pollAnonymous,
      totalVotes: 0,
      createdAt: new Date().toISOString()
    }

    this.sendSocketMessage("create-poll", {
      question: title,
      options: options,
      allowMultiple: this.data.pollMultiple,
      isAnonymous: this.data.pollAnonymous
    })

    this.setData({
      showCreatePollModal: false
    })

    wx.showModal({
      title: '提示',
      content: '投票已发起',
      showCancel: false,
      confirmText: '确定'
    })
  },

  openPollDetail(e) {
    let poll = e.currentTarget.dataset.poll
    if (typeof poll === 'string') {
      try {
        poll = JSON.parse(poll)
      } catch (e) {
        console.error("解析投票数据失败:", e)
        return
      }
    }

    const hasVoted = this.data.votedPolls.includes(poll.id)

    this.setData({
      showPollDetail: true,
      selectedPoll: poll,
      pollSelectedOptions: [],
      hasVoted: hasVoted
    })
  },

  closePollDetail() {
    this.setData({ showPollDetail: false })
  },

  selectPollOption(e) {
    if (this.data.hasVoted) return

    const index = parseInt(e.currentTarget.dataset.index)
    let selectedOptions = [...this.data.pollSelectedOptions]

    if (this.data.selectedPoll?.multiple) {
      if (selectedOptions.includes(index)) {
        selectedOptions = selectedOptions.filter(i => i !== index)
      } else {
        selectedOptions.push(index)
      }
    } else {
      selectedOptions = [index]
    }

    this.setData({ pollSelectedOptions: selectedOptions })
  },

  submitPollVote() {
    if (this.data.pollSelectedOptions.length === 0) {
      wx.showModal({
        title: '提示',
        content: '请选择选项',
        showCancel: false,
        confirmText: '确定'
      })
      return
    }

    const voteData = {
      pollId: this.data.selectedPoll.id,
      options: this.data.pollSelectedOptions
    }

    this.sendSocketMessage("poll-vote", voteData)

    this.setData({
      showPollDetail: false,
      hasVoted: true,
      votedPolls: [...this.data.votedPolls, this.data.selectedPoll.id]
    })

    wx.showModal({
      title: '提示',
      content: '投票成功',
      showCancel: false,
      confirmText: '确定'
    })
  },

  // ===== 游戏相关功能 =====

  showGomokuGame(data) {
    console.log("显示五子棋游戏:", data)
    this.navigateToGame(data)
  },

  showRpsGame(data) {
    console.log("显示剪刀石头布游戏:", data)
    this.navigateToGame(data)
  },

  showGuessNumberGame(data) {
    console.log("显示猜数字游戏:", data)
    this.navigateToGame(data)
  },

  showBombGame(data) {
    console.log("显示数字炸弹游戏:", data)
    this.navigateToGame(data)
  },

  showPictionaryGame(data) {
    console.log("显示你画我猜游戏:", data)
    this.navigateToGame(data)
  },

  showTypingGame(data) {
    console.log("显示打字对战游戏:", data)
    this.navigateToGame(data)
  },

  navigateToGame(gameData) {
    const gameDataWithUser = {
      ...gameData,
      currentUsername: this.data.username
    }

    const encodedData = encodeURIComponent(JSON.stringify(gameDataWithUser))
    wx.navigateTo({
      url: `/pages/game/game?gameData=${encodedData}`
    })
  },

  handleGameInvitation(invitation) {
    console.log("处理游戏邀请:", invitation)

    const gameNames = {
      gomoku: '♟️ 五子棋',
      rps: '✊ 剪刀石头布',
      'guess-number': '🔢 猜数字',
      bomb: '💣 数字炸弹',
      pictionary: '🎨 你画我猜',
      typing: '⌨️ 打字对战'
    }

    const gameName = gameNames[invitation.gameType] || invitation.gameType

    wx.showModal({
      title: '🎮 游戏邀请',
      content: `${invitation.fromUsername} 邀请你玩 ${gameName}`,
      confirmText: '接受',
      cancelText: '拒绝',
      success: (res) => {
        if (res.confirm) {
          this.acceptGameInvitation({ currentTarget: { dataset: { id: invitation.id } } })
        } else {
          this.rejectGameInvitation({ currentTarget: { dataset: { id: invitation.id } } })
        }
      }
    })

    this.loadGameInvitations()
  },

  acceptGameInvitation(e) {
    const invitationId = e.currentTarget.dataset.id
    console.log("接受游戏邀请:", invitationId)

    if (!this.pendingMessages) {
      this.pendingMessages = new Set()
    }

    if (this.socket) {
      const messageId = 'msg_' + Date.now()
      this.pendingMessages.add(messageId)
      const data = JSON.stringify({
        invitationId: invitationId,
        accept: true
      })
      this.socket.send({
        data: '42["respond-to-game-invitation",' + data + ']'
      })

      wx.showModal({
        title: '提示',
        content: '已接受邀请',
        showCancel: false,
        confirmText: '确定'
      })

      this.loadGameInvitations()
    }
  },

  rejectGameInvitation(e) {
    const invitationId = e.currentTarget.dataset.id
    console.log("拒绝游戏邀请:", invitationId)

    if (!this.pendingMessages) {
      this.pendingMessages = new Set()
    }

    if (this.socket) {
      const messageId = 'msg_' + Date.now()
      this.pendingMessages.add(messageId)
      const data = JSON.stringify({
        invitationId: invitationId,
        accept: false
      })
      this.socket.send({
        data: '42["respond-to-game-invitation",' + data + ']'
      })

      wx.showModal({
        title: '提示',
        content: '已拒绝邀请',
        showCancel: false,
        confirmText: '确定'
      })

      this.loadGameInvitations()
    }
  },

  handleGameStart(data) {
    console.log("处理游戏开始事件:", data)

    this.setData({
      showInteractiveCenter: false,
      currentGame: data
    })

    const gameTypeName = {
      gomoku: '五子棋',
      rps: '剪刀石头布',
      'guess-number': '猜数字',
      bomb: '数字炸弹',
      pictionary: '你画我猜',
      typing: '打字对战'
    }

    wx.showModal({
      title: '🎮 游戏开始',
      content: `游戏类型：${gameTypeName[data.gameType] || data.gameType}\n\n对手：${data.players?.map(p => p.username).join(', ') || '未知'}`,
      showCancel: false,
      confirmText: '进入游戏',
      success: () => {
        if (data.gameType === 'gomoku') {
          this.showGomokuGame(data)
        } else if (data.gameType === 'rps') {
          this.showRpsGame(data)
        } else if (data.gameType === 'guess-number') {
          this.showGuessNumberGame(data)
        } else if (data.gameType === 'bomb') {
          this.showBombGame(data)
        } else if (data.gameType === 'pictionary') {
          this.showPictionaryGame(data)
        } else if (data.gameType === 'typing') {
          this.showTypingGame(data)
        } else {
          this.showError(`暂不支持${gameTypeName[data.gameType] || data.gameType}游戏`)
        }
      }
    })
  },

  handleGameUpdate(data) {
    console.log("处理游戏更新事件:", data)

    const currentGame = this.data.currentGame

    if (currentGame && currentGame.gameId === data.gameId) {
      this.setData({
        currentGame: {
          ...currentGame,
          board: data.board,
          currentPlayer: data.currentPlayer,
          status: data.status,
          winner: data.winner
        }
      })

      if (data.winner) {
        const winnerName = data.winner === this.data.username ? '你' : data.winner
        wx.showModal({
          title: '🏆 游戏结束',
          content: `${winnerName} 获胜！`,
          showCancel: false,
          success: () => {
            wx.navigateBack()
          }
        })
      }
    }
  },

  handleGameEnd(data) {
    console.log("游戏结束:", data)

    if (data.gameId !== this.data.gameId) return

    const players = data.players || this.data.players
    const winnerPlayer = players.find(p => p.socketId === data.winner)
    const winnerName = winnerPlayer?.username || data.winner || '未知'
    const displayName = winnerName === this.data.username ? '你' : winnerName

    wx.showModal({
      title: '🏆 游戏结束',
      content: `${displayName} 获胜！`,
      showCancel: false,
      success: () => {
        wx.navigateBack()
      }
    })
  },

  handlePollCreated(poll) {
    console.log("收到投票创建事件:", poll)

    const msgId = poll.id || Date.now().toString()
    this.messageIds.push(msgId)
    this.processedServerMsgIds.add(msg.id)

    const newMsgs = [{
      id: msgId,
      user: { nickName: poll.username || "未知", avatarUrl: poll.avatarUrl || '' },
      type: 'poll',
      poll: poll,
      time: that.formatTimestamp(poll.timestamp),
      isSelf: poll.username === that.data.username
    }]

    this.setData({
      messages: that.data.messages.concat(newMsgs),
      scrollTop: 999999
    })
  },

  handlePollUpdated(poll) {
    console.log("收到投票更新事件:", poll)

    if (this.data.currentPoll && this.data.currentPoll.id === poll.id) {
      this.setData({ currentPoll: poll })
    }
  },

  handlePollEnded(pollId) {
    console.log("收到投票结束事件:", pollId)

    if (this.data.currentPoll && this.data.currentPoll.id === pollId) {
      this.setData({ showPoll: false })
    }
  },

  // ===== 游戏相关功能 =====

  inviteUserToGame(e) {
    const userId = e.currentTarget.dataset.userId
    const username = e.currentTarget.dataset.username
    const isAI = username === 'ai' || userId === 'pc-bot-virtual-socket'
    console.log("邀请用户:", username, "userId:", userId, "isAI:", isAI)

    const gameList = isAI
      ? ['✊ 剪刀石头布', '♟️ 五子棋', '🔢 猜数字', '💣 数字炸弹']
      : ['✊ 剪刀石头布', '♟️ 五子棋', '🔢 猜数字', '💣 数字炸弹', '🎨 你画我猜', '⌨️ 打字对战']

    const gameTypes = isAI
      ? ['rps', 'gomoku', 'guess-number', 'bomb']
      : ['rps', 'gomoku', 'guess-number', 'bomb', 'pictionary', 'typing']

    this.setData({
      showGameInvitationModal: true,
      gameList: gameList,
      gameTypes: gameTypes,
      targetUserId: userId,
      targetUsername: username
    })
  },

  closeGameInvitationModal() {
    this.setData({ showGameInvitationModal: false })
  },

  selectGame(e) {
    const index = e.currentTarget.dataset.index
    const gameType = this.data.gameTypes[index]

    const data = JSON.stringify({
      gameType: gameType,
      targetUserId: this.data.targetUserId
    })

    this.socket.send({
      data: '42["send-game-invitation",' + data + ']'
    })

    wx.showModal({
      title: '提示',
      content: '邀请已发送',
      showCancel: false,
      confirmText: '确定'
    })

    this.closeGameInvitationModal()
  },

  // ===== 控制台功能 =====

  showDevMenu() {
    console.log("显示开发菜单")
    var that = this
    wx.showActionSheet({
      itemList: [
        "⋯ 更多",
        "🔊 音频播放控制"
      ],
      success: function(res) {
        console.log("开发菜单点击:", res.tapIndex)
        switch(res.tapIndex) {
          case 0:
            that.showAllLogs()
            break
          case 1:
            that.showAudioControlPanel()
            break
        }
      },
      fail: function(res) {
        console.error("开发菜单失败:", res)
      }
    })
  },

  showAudioControlPanel() {
    console.log("显示音频控制面板")
    wx.showActionSheet({
      itemList: [
        "🔊 播放所有音频",
        "⏹️ 停止所有音频"
      ],
      success: function(res) {
        console.log("音频控制点击:", res.tapIndex)
        switch(res.tapIndex) {
          case 0:
            that.playAllAudios()
            break
          case 1:
            that.stopAllAudios()
            break
        }
      },
      fail: function(res) {
        console.error("音频控制失败:", res)
      }
    })
  },

  playAllAudios() {
    const playingAudios = this.data.playingAudios || []
    playingAudios.forEach(audio => {
      const ctx = this.audioContexts[audio.id]
      if (ctx) {
        ctx.play()
      }
    })
  },

  stopAllAudios() {
    const playingAudios = this.data.playingAudios || []
    playingAudios.forEach(audio => {
      const ctx = this.audioContexts[audio.id]
      if (ctx) {
        ctx.pause()
      }
    })
  },

  // ===== 其他辅助功能 =====

  toggleElement(elementName) {
    this.setData({
      [elementName]: !this.data[elementName]
    })
  },

  showInteractiveCenter() {
    console.log('打开互动中心')
    this.setData({ showInteractiveCenter: true })
    this.loadOnlineUsers()
    this.loadActiveGames()
    this.loadGameInvitations()
    this.loadGameHistory()
  },

  showElementStatus() {
    const status = "连接状态: " + (this.data.connected ? "已连接" : "未连接") + "\n" +
      "正在连接: " + (this.data.connecting ? "是" : "否") + "\n" +
      "重连次数: " + this.reconnectAttempts + "/" + this.maxReconnectAttempts + "\n" +
      "使用本地服务器: " + (this.useLocalServer ? "是" : "否") + "\n" +
      "服务器地址: " + this.getServerUrl() + "\n" +
      "用户名: " + this.data.username + "\n" +
      "房间名: " + this.data.roomName

    wx.showModal({
      title: "元素状态",
      content: status,
      showCancel: false,
      confirmText: "确定"
    })
  },

  hideNotification() {
    if (this.notificationTimer) {
      clearTimeout(this.notificationTimer)
      this.notificationTimer = null
    }
    this.setData({
      notification: {
        show: false,
        avatarUrl: '',
        senderName: '',
        content: '',
        msgId: ''
      }
    })
  },

  onTapNotification() {
    this.hideNotification()
    this.setData({ scrollTop: 999999 })
  },

  updateUploadProgress(id, progress) {
    const downloads = this.data.downloads.map(d => {
      if (d.id === id) {
        return { ...d, progress, status: progress >= 100 ? '上传完成' : '上传中' }
      }
      return d
    })
    this.setData({ downloads })
  }
})
