<view class="game-container">
  <view class="game-header">
    <view class="game-back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="game-title">{{gameTitle}}</view>
    <view class="game-status">{{gameStatus}}</view>
  </view>

  <view class="game-content">
    <view class="gomoku-board" wx:if="{{gameType === 'gomoku'}}" bindtouchstart="onBoardTouch">
      <view class="board-grid">
        <view 
          class="board-cell" 
          wx:for="{{board}}" 
          wx:key="index"
          wx:for-item="row"
        >
          <view 
            class="cell" 
            wx:for="{{row}}" 
            wx:key="idx"
            wx:for-item="cell"
            data-x="{{index}}"
            data-y="{{idx}}"
          >
            <view class="piece" wx:if="{{cell}}" style="background: {{cell === currentPlayerId ? '#000' : '#fff'}}; border-color: #000;">
              <view class="piece-inner"></view>
            </view>
            <view class="star-point" wx:if="{{isStarPoint(index, idx)}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="rps-game" wx:if="{{gameType === 'rps'}}">
      <view class="rps-title">选择你的出招</view>
      <view class="rps-options">
        <view class="rps-option" bindtap="playRPS" data-choice="rock">
          <text class="rps-icon">✊</text>
          <text class="rps-label">石头</text>
        </view>
        <view class="rps-option" bindtap="playRPS" data-choice="paper">
          <text class="rps-icon">🖐️</text>
          <text class="rps-label">布</text>
        </view>
        <view class="rps-option" bindtap="playRPS" data-choice="scissors">
          <text class="rps-icon">✌️</text>
          <text class="rps-label">剪刀</text>
        </view>
      </view>
      <view class="rps-result" wx:if="{{rpsResult}}">
        <view class="rps-choices">
          <view class="rps-choice-item">
            <text class="rps-choice-icon">{{myChoiceIcon}}</text>
            <text class="rps-choice-name">你</text>
          </view>
          <view class="rps-vs">VS</view>
          <view class="rps-choice-item">
            <text class="rps-choice-icon">{{opponentChoiceIcon}}</text>
            <text class="rps-choice-name">对手</text>
          </view>
        </view>
        <view class="rps-result-text">{{rpsResult}}</view>
      </view>
    </view>

    <view class="guess-game" wx:if="{{gameType === 'guess-number'}}">
      <view class="guess-title">猜数字游戏</view>
      <view class="guess-range">范围：{{guessMin}} - {{guessMax}}</view>
      <view class="guess-hint" wx:if="{{guessHint}}">{{guessHint}}</view>
      <view class="guess-input-wrap">
        <input 
          class="guess-input" 
          type="number" 
          placeholder="输入你猜的数字" 
          value="{{guessInput}}"
          bindinput="onGuessInput"
          confirm-type="done"
          bindconfirm="submitGuess"
        />
        <button class="guess-btn" bindtap="submitGuess" disabled="{{!guessInput}}">猜测</button>
      </view>
      <view class="guess-history">
        <view class="history-title">猜测记录</view>
        <view class="history-list">
          <view class="history-item" wx:for="{{guessHistory}}" wx:key="index">
            <text class="history-player" style="color: {{item.isMine ? '#44aa44' : '#ff6666'}};">{{item.playerName}}:</text>
            <text class="history-num">{{item.num}}</text>
            <text class="history-result">{{item.result}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bomb-game" wx:if="{{gameType === 'bomb'}}">
      <view class="bomb-title">数字炸弹</view>
      <view class="bomb-range">当前范围：{{bombMin}} - {{bombMax}}</view>
      <view class="bomb-warning" wx:if="{{bombWarning}}">⚠️ {{bombWarning}}</view>
      <view class="bomb-input-wrap">
        <input 
          class="bomb-input" 
          type="number" 
          placeholder="输入数字" 
          value="{{bombInput}}"
          bindinput="onBombInput"
          confirm-type="done"
          bindconfirm="submitBombNumber"
        />
        <button class="bomb-btn" bindtap="submitBombNumber" disabled="{{!bombInput}}">确定</button>
      </view>
      <view class="bomb-history">
        <view class="history-title">已选数字</view>
        <view class="history-grid">
          <view 
            class="history-num-item" 
            wx:for="{{bombHistory}}" 
            wx:key="value"
            style="background: {{item.isBomb ? '#ff4444' : item.isMine ? '#44aa44' : '#eee'}}; color: {{item.isBomb ? '#fff' : '#333'}};"
          >
            {{item.value}}
          </view>
        </view>
      </view>
    </view>

    <view class="pictionary-game" wx:if="{{gameType === 'pictionary'}}">
      <view class="pictionary-title">🎨 你画我猜</view>
      <view class="pictionary-word" wx:if="{{pictionaryWord}}">题目：{{pictionaryWord}}</view>
      <view class="pictionary-canvas" bindtouchstart="onPictionaryTouch" bindtouchmove="onPictionaryMove">
        <canvas canvas-id="pictionaryCanvas" class="pictionary-canvas-element"></canvas>
      </view>
      <view class="pictionary-controls" wx:if="{{pictionaryIsDrawer}}">
        <button class="pictionary-btn" bindtap="clearPictionary">清除画布</button>
        <button class="pictionary-btn" bindtap="submitPictionary">提交画作</button>
      </view>
      <view class="pictionary-guess-bar" wx:if="{{!pictionaryIsDrawer && (gameStatus === 'playing' || gameStatus === '游戏中')}}">
        <input class="pictionary-input" type="text" placeholder="输入你猜的词..."
               value="{{pictionaryInput}}" bindinput="onPictionaryInput"
               bindconfirm="submitPictionaryGuess" confirm-type="send" maxlength="12" />
        <button class="pictionary-guess-btn" bindtap="submitPictionaryGuess">猜</button>
      </view>
      <view class="pictionary-guesses">
        <view class="guesses-title">猜题记录</view>
        <view class="guesses-list">
          <view class="guess-item" wx:for="{{pictionaryGuesses}}" wx:key="index">
            <text class="guess-player">{{item.player}}:</text>
            <text class="guess-text">{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="typing-game" wx:if="{{gameType === 'typing'}}">
      <view class="typing-title">⌨️ 打字对战</view>
      <view class="typing-scores">
        <view class="score-item">
          <text class="score-name">你</text>
          <text class="score-value">{{typingScore}}</text>
        </view>
        <view class="score-vs">VS</view>
        <view class="score-item">
          <text class="score-name">对手</text>
          <text class="score-value">{{typingOpponentScore}}</text>
        </view>
      </view>
      <view class="typing-time" wx:if="{{typingStarted}}">剩余时间：{{typingTimeLeft}}s</view>
      <view class="typing-text" wx:if="{{typingText}}">{{typingText}}</view>
      <view class="typing-input-wrap" wx:if="{{typingStarted}}">
        <input 
          class="typing-input" 
          placeholder="输入你看到的文字..." 
          value="{{typingInput}}"
          bindinput="onTypingInput"
          confirm-type="done"
          bindconfirm="submitTyping"
        />
        <button class="typing-btn" bindtap="submitTyping" disabled="{{!typingInput}}">提交</button>
      </view>
      <view class="typing-result" wx:if="{{typingResult}}">{{typingResult}}</view>
      <button class="typing-start-btn" wx:if="{{!typingStarted}}" bindtap="startTyping">开始游戏</button>
    </view>

      </view>

  <view class="game-footer">
    <view class="game-players">
      <view class="player-item {{isMyTurn ? 'active' : ''}}">
        <text class="player-name">{{myName}}</text>
        <text class="player-turn" wx:if="{{isMyTurn}}">你的回合</text>
      </view>
      <view class="vs-text">VS</view>
      <view class="player-item {{!isMyTurn && gameStarted ? 'active' : ''}}">
        <text class="player-name">{{opponentName}}</text>
        <text class="player-turn" wx:if="{{!isMyTurn && gameStarted}}">对手回合</text>
      </view>
    </view>
  </view>
</view>